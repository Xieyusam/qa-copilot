# LLM API 配置（兼容 OpenAI 接口）
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Embedding 后端：openai 或 sentence-transformers 或 hunyuan
EMBEDDING_BACKEND=hunyuan
EMBEDDING_MODEL=hunyuan-embedding
# (可选) 如果与 LLM 使用不同厂商，请配置以下独立参数，否则默认使用上述 LLM 的配置
EMBEDDING_API_URL=https://api.hunyuan.cloud.tencent.com/v1
EMBEDDING_API_KEY=your_hunyuan_api_key

# 存储路径
CHROMA_PATH=./data/chroma
SQLITE_URL=sqlite:///./data/knowledge_base.db
FILE_STORAGE_PATH=./data/files

# 文件上传限制（MB）
MAX_FILE_SIZE_MB=100

# JWT 鉴权配置
SECRET_KEY=supersecretkey_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 飞书文档拉取配置
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_ENABLE=false

# Jira 配置（可选，用于 Jira 工具集成）
# Jira Cloud: 使用邮箱作为 username，API Token 作为 password
# Jira Server/Data Center: 使用用户名和密码
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_PASSWORD=your-jira-api-token-or-password
